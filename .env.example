# Copy to .env and fill in from https://developer.schwab.com (your app's Keys tab).
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# Must match the Callback URL registered on your Schwab app exactly.
# Schwab requires https. https://127.0.0.1 is the usual choice for local apps.
SCHWAB_REDIRECT_URI=https://127.0.0.1

# Where the OAuth tokens are cached (gitignored).
SCHWAB_TOKEN_PATH=schwab_token.json

# Server
HOST=127.0.0.1
PORT=8182

# Seconds between live quote polls in the browser
QUOTE_POLL_SECONDS=5

# Cache TTL (seconds) for historical bars, per timeframe
HISTORY_CACHE_SECONDS=30
