# Schwab data comes from the central schwab_hub (../schwab_hub/run.sh); no credentials here.
# SCHWAB_HUB_URL=http://127.0.0.1:8765

# Server
HOST=127.0.0.1
PORT=8182

# Seconds between live quote polls in the browser
QUOTE_POLL_SECONDS=5

# Cache TTL (seconds) for historical bars, per timeframe
HISTORY_CACHE_SECONDS=30

# Screener pacing. Measured against a live account: 517 symbols at concurrency 16
# finished in 6.3s clean, while concurrency 24 tripped Schwab's edge protection
# (HTTP 429, then a sustained 403 Access Denied that took minutes to clear).
# These defaults sit well below that cliff and the limiter backs off on its own.
SCREEN_REQUESTS_PER_MINUTE=1200
SCREEN_CONCURRENCY=8
